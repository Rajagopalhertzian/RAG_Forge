# ContextForge Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=contextforge
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4

# =============================================================================
# DATABASE (PostgreSQL + pgvector)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contextforge
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# =============================================================================
# REDIS (Celery broker, rate limiting, caching)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# CELERY (Async task processing)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# =============================================================================
# VECTOR STORES
# =============================================================================
# Primary: pgvector (HNSW)
VECTOR_STORE=pgvector
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_HNSW_EF_SEARCH=40

# Fallback: FAISS (local dev)
FAISS_INDEX_PATH=./data/faiss_index
FAISS_INDEX_TYPE=HNSW32

# Optional: Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_CLASS_PREFIX=ContextForge

# =============================================================================
# EMBEDDING PROVIDERS
# =============================================================================
# OpenAI / Azure OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Local (sentence-transformers)
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DIMENSIONS=1024
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=32

# =============================================================================
# CHUNKING CONFIGURATION
# =============================================================================
DEFAULT_CHUNK_STRATEGY=semantic
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
SEMANTIC_CHUNK_THRESHOLD=0.7
HIERARCHICAL_PARENT_SIZE=1024
HIERARCHICAL_CHILD_SIZE=256
CODE_CHUNK_MAX_LINES=100
FIXED_CHUNK_SEPARATORS=["\n\n", "\n", ". ", " ", ""]

# =============================================================================
# RATE LIMITING (Token Bucket)
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
RATE_LIMIT_REDIS_KEY_PREFIX=ratelimit:

# =============================================================================
# OBSERVABILITY
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=contextforge
OTEL_SAMPLER=always_on
PROMETHEUS_METRICS_PORT=9090

# =============================================================================
# SECURITY
# =============================================================================
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# MCP GATEWAY
# =============================================================================
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_AUTH_ENABLED=true
MCP_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
MCP_REDIRECT_URI=http://localhost:8001/callback

# OAuth Providers (Clerk for dev, Cognito for prod)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
CLERK_ISSUER_URL=
CLERK_CLIENT_ID=
CLERK_CLIENT_SECRET=

# =============================================================================
# INGESTION
# =============================================================================
INGESTION_MAX_FILE_SIZE_MB=100
INGESTION_MAX_CONCURRENT_JOBS=4
INGESTION_CHUNK_BATCH_SIZE=100
INGESTION_EMBEDDING_BATCH_SIZE=32
INGESTION_RETRY_ATTEMPTS=3
INGESTION_RETRY_BACKOFF=2.0

# Source-specific
NOTION_API_KEY=
NOTION_API_VERSION=2022-06-28
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
GITHUB_TOKEN=
GITHUB_ORG=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=